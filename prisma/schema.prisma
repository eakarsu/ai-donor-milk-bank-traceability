// Generated schema — modeled after beautyhqio conventions.
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  active       Boolean @default(true)
  id           String   @id @default(cuid())
  email        String   @unique
  name         String
  passwordHash String
  role         Role     @default(ANALYST)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

enum Role {
  ADMIN
  MANAGER
  ANALYST
}

model AuditLog {
  id        String   @id @default(cuid())
  actorId   String?
  actorName String?
  action    String
  entity    String
  entityId  String?
  detail    String?
  createdAt DateTime @default(now())
}

model WorkflowAnalysis {
 id String @id @default(cuid())
 actorId String
 workflow String
 subjectEntity String
 subjectId String
 input Json
 evidence Json
 evidenceHash String
 result Json
 model String
 receipt String?
 createdAt DateTime @default(now())
 @@index([workflow, createdAt])
}
model RecordReview {
 id String @id @default(cuid())
 actorId String
 entity String
 entityId String
 version String
 reason String
 createdAt DateTime @default(now())
 @@unique([entity, entityId, version, actorId])
}
model UsageBucket {
 id String @id
 calls Int
}
model IssuedCredential {
 token String @id
 entity String
 entityId String
 version String
 assertion Json
 createdAt DateTime @default(now())
 revokedAt DateTime?
 @@index([entity, entityId, createdAt])
}

model DomainArtifact {
 id String @id @default(cuid())
 subjectEntity String
 subjectId String
 title String
 content String
 contentHash String
 actorId String
 approvedBy String?
 createdAt DateTime @default(now())
 @@index([subjectEntity, subjectId])
}

model RecordApproval {
 id String @id
 version String
}
model DomainExecution {
 id String @id
 actorId String
 connectorId String
 action String
 subjectEntity String
 subjectId String
 version String
 status String
 result Json?
 createdAt DateTime @default(now())
}

model WorkSession {
 id String @id @default(cuid())
 actorId String
 respondentId String
 subjectEntity String
 subjectId String
 questions Json
 answers Json
 currentQuestion String?
 status String
 deadline DateTime
 createdAt DateTime @default(now())
 @@index([respondentId, createdAt])
}
model SessionMedia {
 id String @id @default(cuid())
 sessionId String
 questionId String
 actorId String
 contentType String
 bytes Bytes
 contentHash String
 createdAt DateTime @default(now())
 @@index([sessionId])
}

model AppSetting {
 id String @id
 value Json
 updatedAt DateTime @updatedAt
}

model MilkBankProgram {
 id String @id @default(cuid())
 name String
 facility String
 licenseReference String
 coordinator String
 reportingStart DateTime
 reportingEnd DateTime
 status String @default("Draft")
 createdAt DateTime @default(now())
 updatedAt DateTime @updatedAt
 @@index([createdAt])
 inverseMilkDonor_milkBankProgramId MilkDonor[] @relation("MilkDonor_milkBankProgramId")
 inverseMilkDonation_milkBankProgramId MilkDonation[] @relation("MilkDonation_milkBankProgramId")
 inverseMilkPool_milkBankProgramId MilkPool[] @relation("MilkPool_milkBankProgramId")
 inversePoolContribution_milkBankProgramId PoolContribution[] @relation("PoolContribution_milkBankProgramId")
 inversePasteurizationRun_milkBankProgramId PasteurizationRun[] @relation("PasteurizationRun_milkBankProgramId")
 inverseMilkLabCheck_milkBankProgramId MilkLabCheck[] @relation("MilkLabCheck_milkBankProgramId")
 inverseMilkDistribution_milkBankProgramId MilkDistribution[] @relation("MilkDistribution_milkBankProgramId")
 inverseMilkRecall_milkBankProgramId MilkRecall[] @relation("MilkRecall_milkBankProgramId")
 inverseOperationalTask_milkBankProgramId OperationalTask[] @relation("OperationalTask_milkBankProgramId")
 inverseRuleVersion_milkBankProgramId RuleVersion[] @relation("RuleVersion_milkBankProgramId")
 inverseDocumentRequirement_milkBankProgramId DocumentRequirement[] @relation("DocumentRequirement_milkBankProgramId")
}

model MilkDonor {
 id String @id @default(cuid())
 name String
 donorCode String
 consentAt DateTime
 screeningEvidence String
 reviewDueAt DateTime
 status String @default("Draft")
 milkBankProgramId String
 createdAt DateTime @default(now())
 updatedAt DateTime @updatedAt
 @@index([createdAt])
 @@index([milkBankProgramId])
 linkedMilkBankProgramId MilkBankProgram @relation("MilkDonor_milkBankProgramId", fields: [milkBankProgramId], references: [id], onDelete: Restrict)
 inverseMilkDonation_milkDonorId MilkDonation[] @relation("MilkDonation_milkDonorId")
}

