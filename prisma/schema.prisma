 linkedMilkBankProgramId MilkBankProgram @relation("MilkDonation_milkBankProgramId", fields: [milkBankProgramId], references: [id], onDelete: Restrict)
 inversePoolContribution_milkDonationId PoolContribution[] @relation("PoolContribution_milkDonationId")
}

model MilkPool {
